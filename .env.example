# Variable names only. Put real values in "Portfolio Projects/.env" (shared) or in a .env in this folder.
# Never commit a .env file.

# Chat models through OpenRouter (OpenAI-compatible API). Copy current ids from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAIN=
MODEL_CHEAP=
# The judge should be from a different model family than MODEL_MAIN / MODEL_CHEAP.
MODEL_JUDGE=

# Optional: embeddings for --retriever embedding/hybrid (a multilingual model; any OpenAI-compatible /embeddings API).
# Base URL and key default to the OpenRouter ones above.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Budget guard for evals/run.py (US$)
MAX_COST_PER_RUN_USD=3
